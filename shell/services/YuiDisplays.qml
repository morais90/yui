pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io

// Display configuration for Yui Settings > Displays.
//
// Reads the outputs from Hyprland, applies changes live and, once the user
// keeps them, saves them to ~/.config/hypr/monitors.lua (loaded by yui.lua).
// Like macOS, a change must be confirmed within `confirmSeconds` or it is
// reverted, so a mode the screen can't show never leaves it black.
Singleton {
    id: root

    // [{ name, desc, make, model, width, height, refresh, x, y, scale, transform, modes: [{width, height, refresh}] }]
    property list<var> monitors: []
    // Configuration being tried; null when nothing is pending
    property var pending: null
    property var previous: null
    readonly property int confirmSeconds: 15
    property int secondsLeft: 0

    readonly property string file: `${Quickshell.env("HOME")}/.config/hypr/monitors.lua`

    function refresh(): void {
        query.running = true;
    }

    // Logical size: what the screen takes in the layout
    function logicalWidth(m: var): real {
        return (m.transform % 2 ? m.height : m.width) / m.scale;
    }

    function logicalHeight(m: var): real {
        return (m.transform % 2 ? m.width : m.height) / m.scale;
    }

    function modeString(m: var): string {
        return `${m.width}x${m.height}@${Math.round(m.refresh * 100) / 100}`;
    }

    function luaFor(m: var): string {
        const output = m.desc ? `desc:${m.desc}` : m.name;
        return `hl.monitor({ output = ${JSON.stringify(output)}, mode = "${modeString(m)}", position = "${Math.round(m.x)}x${Math.round(m.y)}", scale = ${m.scale}, transform = ${m.transform} })`;
    }

    // Try a configuration (array like `monitors`); keep() or revert() follow
    function apply(config: list<var>): void {
        if (!pending)
            previous = monitors.map(m => Object.assign({}, m));
        pending = config.map(m => Object.assign({}, m));
        applyLive(pending);
        secondsLeft = confirmSeconds;
        countdown.restart();
    }

    function keep(): void {
        if (!pending)
            return;
        countdown.stop();
        save(pending);
        pending = null;
        previous = null;
        refreshLater.restart();
    }

    function revert(): void {
        if (!pending)
            return;
        countdown.stop();
        applyLive(previous);
        pending = null;
        previous = null;
        refreshLater.restart();
    }

    function applyLive(config: list<var>): void {
        for (const m of config)
            Quickshell.execDetached(["hyprctl", "dispatch", `function() ${luaFor(m)} end`]);
        refreshLater.restart();
    }

    function save(config: list<var>): void {
        const lines = ["-- Displays: generated by Yui Settings > Displays.", "-- Change them there; edits to this file are overwritten. To override a", "-- setting by hand, add your own hl.monitor() to hyprland.lua instead.", ""];
        for (const m of config)
            lines.push(luaFor(m));
        saver.setText(lines.join("\n") + "\n");
    }

    Timer {
        id: countdown

        interval: 1000
        repeat: true
        onTriggered: {
            root.secondsLeft -= 1;
            if (root.secondsLeft <= 0)
                root.revert();
        }
    }

    Timer {
        id: refreshLater

        interval: 600
        onTriggered: root.refresh()
    }

    FileView {
        id: saver

        path: root.file
        printErrors: false
    }

    Process {
        id: query

        command: ["hyprctl", "monitors", "-j"]
        stdout: StdioCollector {
            onStreamFinished: {
                let list = [];
                try {
                    list = JSON.parse(text);
                } catch (e) {
                    return;
                }
                root.monitors = list.filter(m => !m.disabled).map(m => ({
                            name: m.name,
                            desc: (m.description ?? "").trim(),
                            make: m.make,
                            model: (m.model ?? "").trim(),
                            width: m.width,
                            height: m.height,
                            refresh: m.refreshRate,
                            x: m.x,
                            y: m.y,
                            scale: m.scale,
                            transform: m.transform,
                            modes: (m.availableModes ?? []).map(s => {
                                const r = /(\d+)x(\d+)@([\d.]+)/.exec(s);
                                return r ? {
                                    width: +r[1],
                                    height: +r[2],
                                    refresh: +r[3]
                                } : null;
                            }).filter(x => x)
                        }));
            }
        }
    }

    // Outputs plugged in or out
    Connections {
        target: Quickshell

        function onScreensChanged(): void {
            refreshLater.restart();
        }
    }

    IpcHandler {
        target: "displays"

        function list(): string {
            return JSON.stringify(root.monitors.map(m => ({
                        name: m.name,
                        mode: root.modeString(m),
                        x: m.x,
                        y: m.y,
                        scale: m.scale,
                        transform: m.transform
                    })));
        }

        function pendingSeconds(): int {
            return root.pending ? root.secondsLeft : -1;
        }

        function keep(): void {
            root.keep();
        }

        function revert(): void {
            root.revert();
        }
    }

    Component.onCompleted: refresh()
}
