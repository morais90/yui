# Maintainer: Willian Morais
# Yui CLI: built from cli/ (a fork of the Caelestia CLI, GPL-3.0)
pkgname=yui-cli
_upstream_version=1.1.3
pkgver=1.1.3.r1
pkgrel=1
pkgdesc="Yui CLI: color schemes, wallpapers, screenshots and shell control (fork of Caelestia CLI)"
arch=('any')
url="https://github.com/morais90/yui"
license=('GPL-3.0-only')
depends=(python python-pillow python-materialyoucolor libnotify swappy grim dart-sass
         wl-clipboard slurp gpu-screen-recorder dconf cliphist fuzzel git)
makedepends=(python-build python-installer python-hatchling python-hatch-vcs)
provides=(caelestia-cli)
conflicts=(caelestia-cli caelestia-cli-git)

build() {
    rm -rf "$srcdir/cli"
    cp -r "$startdir/../../cli" "$srcdir/cli"
    cd "$srcdir/cli"
    # No git tags inside the Yui repo: tell hatch-vcs the version explicitly
    SETUPTOOLS_SCM_PRETEND_VERSION="$_upstream_version" python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/cli"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 completions/caelestia.fish "$pkgdir/usr/share/fish/vendor_completions.d/caelestia.fish"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
