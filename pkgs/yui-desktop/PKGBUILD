# Maintainer: Willian Morais
pkgname=yui-desktop
pkgver=0.9.0
pkgrel=1
pkgdesc="Yui desktop: Hyprland defaults, idle, helper scripts"
arch=('any')
url="https://github.com/morais90/yui"
license=('MIT')
depends=(
    # session
    hyprland uwsm sddm xdg-desktop-portal-hyprland xdg-desktop-portal-gtk
    hyprpolkitagent qt5-wayland qt6-wayland
    # shell: Yui Shell (Caelestia fork, includes the dock and switcher)
    yui-shell yui-hyprland-plugins quickshell-git hypridle wofi
    network-manager-applet blueman pavucontrol
    # tools used by keybinds and scripts
    # terminal: fish with the Starship prompt (Yui theme in vendor_conf.d)
    fish starship
    # archives: Ark (Dolphin's "Extract here", opens .zip/.7z/.tar) and its backends
    ark unzip zip 7zip
    ghostty xdg-terminal-exec dolphin grim slurp wl-clipboard cliphist brightnessctl playerctl
    xdg-user-dirs xdg-utils jq
    # title bars (AUR for now; will be built into the Yui repository)
    hyprland-plugin-hyprbars
    # look and feel
    ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji noto-fonts-cjk
    papirus-icon-theme nwg-look
)
install=yui-desktop.install

package() {
    local src="$startdir/../../desktop"
    install -Dm755 -t "$pkgdir/usr/bin"                   "$src"/bin/*
    install -Dm644 -t "$pkgdir/usr/share/yui/hypr"        "$src"/hypr/*
    install -Dm644 -t "$pkgdir/usr/share/yui/ghostty"     "$src"/ghostty/*
    install -Dm644 -t "$pkgdir/usr/share/yui/skel"        "$src"/skel/hyprland.lua
    install -Dm644 -t "$pkgdir/usr/share/yui/skel/ghostty" "$src"/skel/ghostty/config.ghostty
    install -Dm644 "$src/fish/yui.fish"                    "$pkgdir/usr/share/fish/vendor_conf.d/yui.fish"
    install -Dm644 "$src/starship/starship.toml"           "$pkgdir/usr/share/yui/starship/starship.toml"
    install -Dm644 "$src/skel/hyprland.lua"               "$pkgdir/etc/skel/.config/hypr/hyprland.lua"
    install -Dm644 "$src/skel/ghostty/config.ghostty"     "$pkgdir/etc/skel/.config/ghostty/config.ghostty"
    install -Dm644 "$src/xdg/xdg-terminals.list"          "$pkgdir/etc/xdg/xdg-terminals.list"
    install -Dm644 -t "$pkgdir/usr/lib/systemd/user"      "$src"/systemd/user/*.service
    local unit
    for unit in "$src"/systemd/user/*.service.d; do
        install -Dm644 -t "$pkgdir/usr/lib/systemd/user/$(basename "$unit")" "$unit"/*
    done
}
