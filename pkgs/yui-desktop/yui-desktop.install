_user_units="hypridle.service hyprpolkitagent.service yui-shell.service yui-dock.service"
# Replaced by the Yui Shell (Caelestia fork) in 0.4.0
_old_units="waybar.service hyprpaper.service"

post_install() {
    systemctl --global enable $_user_units >/dev/null 2>&1
    systemctl enable sddm.service >/dev/null 2>&1
    echo ">> Yui desktop installed. Each existing user should run: yui-setup"
}

post_upgrade() {
    systemctl --global disable $_old_units >/dev/null 2>&1
    systemctl --global enable $_user_units >/dev/null 2>&1
}

pre_remove() {
    systemctl --global disable $_user_units >/dev/null 2>&1
}
