# Maintainer: Willian Morais
# Yui Shell: built from shell/ (a fork of the Caelestia shell, GPL-3.0)
pkgname=yui-shell
_upstream_version=2.5.0
_upstream_rev=e72df8e
pkgver=2.5.0.r1
pkgrel=1
pkgdesc="Yui Shell: bar, launcher, dashboard, notifications, lock (fork of Caelestia)"
arch=('x86_64')
url="https://github.com/morais90/yui"
license=('GPL-3.0-only')
depends=(
    yui-cli quickshell-git qt6-m3shapes-git libcava ttf-rubik-vf
    glibc gcc-libs ddcutil brightnessctl networkmanager lm_sensors aubio
    libpipewire libqalculate power-profiles-daemon
    ttf-material-symbols-variable ttf-cascadia-code-nerd
    qt6-base qt6-declarative qt6-imageformats swappy fish bash
)
optdepends=('fprintd: fingerprint unlock for the lock screen')
makedepends=(cmake ninja qt6-shadertools)
provides=(caelestia-shell)
conflicts=(caelestia-shell caelestia-shell-git)

build() {
    cmake -S "$startdir/../../shell" -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/ \
        -DVERSION="$_upstream_version" \
        -DGIT_REVISION="$_upstream_rev" \
        -DDISTRIBUTOR="Yui (package: $pkgname)"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$startdir/../../shell/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
