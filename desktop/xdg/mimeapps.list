text/x-diff=dev.zed.Zed.desktop
application/x-desktop=dev.zed.Zed.desktop
text/x-readme=dev.zed.Zed.desktop
text/x-tex=dev.zed.Zed.desktop
application/x-zerosize=dev.zed.Zed.desktop
application/x-ini=dev.zed.Zed.desktop
